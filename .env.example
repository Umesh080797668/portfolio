# =====================================================================
# Portfolio backend configuration
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# NEVER commit ".env" (it is in .gitignore). Only this example file,
# which contains no real secrets, belongs in Git.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=production

# Public website + visitor API (tracking, uploads, requests)
PUBLIC_PORT=3000
PUBLIC_HOST=0.0.0.0

# Admin dashboard + admin API. Runs as a SEPARATE server on its own port.
# Keep it bound to localhost and expose it only through a private network
# (VPN / Tailscale / Cloudflare Access) or a separate admin sub-domain that
# is protected by your reverse proxy. Never put it on the public site.
ADMIN_PORT=3001
ADMIN_BIND_HOST=127.0.0.1

# Number of reverse proxies in front of the server (0 = none, 1 = nginx/Render/Railway...)
# Needed so rate limiting sees the real visitor IP.
TRUST_PROXY=1

# Public address of your website. Used to build the tracking links you send to clients.
# Example: https://www.yourdomain.com
PUBLIC_BASE_URL=

# Comma separated list of origins allowed to call the public API from the browser.
# Leave empty when the site and API are served from the same server.
# Example when the site is on GitHub Pages: https://umesh080797668.github.io
CORS_ORIGINS=

# Only needed if the static site is hosted somewhere else than this server.
# Empty = same origin. Example: https://api.yourdomain.com
PUBLIC_API_BASE=

# ---------- Supabase (database + admin login) ----------
# Project Settings -> API
SUPABASE_URL=
# Public "anon" key. Safe for the admin login page, protected by Row Level Security.
SUPABASE_ANON_KEY=
# SECRET. Server only. Bypasses Row Level Security. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Cloudinary (file storage) ----------
# Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET. Server only. Used to sign uploads and create private download links.
CLOUDINARY_API_SECRET=
# Root folder for everything this app stores
CLOUDINARY_FOLDER=techassist

# ---------- Admin security ----------
# Comma separated e-mail addresses allowed to open the admin dashboard.
# These users must also exist in Supabase Auth (create them manually and
# DISABLE public sign-ups in Supabase: Authentication -> Providers -> Email).
ADMIN_EMAILS=
# Require TOTP two-factor authentication (Supabase MFA, assurance level aal2).
# Keep this true in production.
ADMIN_REQUIRE_MFA=true

# Random secret (32+ characters) used to sign upload tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
UPLOAD_TOKEN_SECRET=

# ---------- Upload limits ----------
# Cloudinary free plans allow up to 10 MB per file.
MAX_FILE_MB=10
MAX_FILES_PER_REQUEST=5

# ---------- Public contact settings (not secret, but kept here so nothing is hard-coded) ----------
WHATSAPP_NUMBER=94704124816
# Formspree form id for the contact form (the part after /f/ in the endpoint URL)
FORMSPREE_FORM_ID=
