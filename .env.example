# ====================================================================
# TECHASSIST LK - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file as `.env` and fill in your actual credentials.
# NEVER commit the `.env` file to public version control (Git).
# ====================================================================

# --------------------------------------------------------------------
# 1. CLOUDINARY CONFIGURATION (Storage for PDFs, Excel, TXT, Word, Images)
# Create a free account at: https://cloudinary.com
# --------------------------------------------------------------------
# Your Cloudinary Cloud Name (Dashboard -> Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Unsigned Upload Preset for direct client-side uploads from browser
# (Settings -> Upload -> Upload presets -> Add unsigned preset)
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Optional API Key & Secret (only needed if backend server SDK is used)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upload folder name in Cloudinary Media Library
CLOUDINARY_FOLDER=techassist_lk/tasks

# --------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Database & Real-time Live Tracking)
# Create a free project at: https://supabase.com
# Run the SQL script from `supabase_schema.sql` in Supabase SQL Editor
# --------------------------------------------------------------------
# Supabase Project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Project Settings -> API -> Project API Keys -> anon public)
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (Keep strictly secret; only for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --------------------------------------------------------------------
# 3. WORK TRACKER ADMIN & NOTIFICATION SETTINGS
# --------------------------------------------------------------------
# 4-Digit PIN to unlock the Staff / Admin Work Tracker Portal
ADMIN_TRACKER_PIN=2026

# WhatsApp Number for receiving quotes & sending tracking links (country code without +)
ADMIN_WHATSAPP_NUMBER=94704124816

# Primary contact email
ADMIN_EMAIL=Umeshbandara08@gmail.com

# --------------------------------------------------------------------
# 4. APP & PORTFOLIO DEPLOYMENT URL
# --------------------------------------------------------------------
PORTFOLIO_SITE_URL=https://imanthaumesh.github.io/portfolio

