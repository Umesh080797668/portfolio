# =====================================================================
# BACKEND configuration  (backend/.env)
# Copy this file to ".env" inside the backend folder and fill in your values:
#     cd backend && cp .env.example .env
#
# This file holds the SECRETS. It must never be copied into the frontend and never
# committed (".env" is ignored by Git). The website has its own, secret-free file:
# frontend/.env.example
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=production

# ----- Hosting on VERCEL -----
# Vercel provides the port, so the PORT settings below are only for running locally (npm start) or on a VPS.
# On Vercel the visitor API and the admin dashboard are the same project but different HOST NAMES:
#   api.yourdomain.com    -> visitor API only
#   admin.yourdomain.com  -> admin dashboard (set it here). Leave empty to switch the dashboard OFF.
# Add both domains in Vercel -> Project -> Settings -> Domains.
ADMIN_HOSTNAME=

# ----- Local / VPS only -----
PUBLIC_PORT=3000
PUBLIC_HOST=0.0.0.0
# Admin dashboard on its own port, bound to localhost.
ADMIN_PORT=3001
ADMIN_BIND_HOST=127.0.0.1

# Number of reverse proxies in front of the server (1 on Vercel / Render / Railway / nginx, 0 when running directly).
# Needed so rate limiting sees the real visitor IP.
TRUST_PROXY=1

# ---------- Website address ----------
# Where the frontend is hosted, WITHOUT a trailing slash. Used for:
#   1. CORS: only this origin may call the API from a browser
#   2. the tracking links you send to clients (<FRONTEND_URL>/services.html?track=CODE#track)
# Example: https://www.yourdomain.com
FRONTEND_URL=
# Extra allowed origins, comma separated (for example a staging site). Usually empty.
CORS_ORIGINS=

# ---------- Supabase (database + admin login) ----------
# Project Settings -> API
SUPABASE_URL=
# Public "anon" key. Safe for the admin login page, protected by Row Level Security.
SUPABASE_ANON_KEY=
# SECRET. Server only. Bypasses Row Level Security. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Cloudinary (file storage) ----------
# Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET. Server only. Used to sign uploads and create private download links.
CLOUDINARY_API_SECRET=
# Root folder for everything this app stores
CLOUDINARY_FOLDER=techassist

# ---------- Admin security ----------
# Comma separated e-mail addresses allowed to open the admin dashboard.
# These users must also exist in Supabase Auth (create them manually and
# DISABLE public sign-ups in Supabase: Authentication -> Providers -> Email).
ADMIN_EMAILS=
# Require TOTP two-factor authentication (Supabase MFA, assurance level aal2).
# Keep this true in production.
ADMIN_REQUIRE_MFA=true

# Random secret (32+ characters) used to sign upload tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
UPLOAD_TOKEN_SECRET=

# ---------- Upload limits (the server is the authority; the website only shows these) ----------
# Cloudinary free plans allow up to 10 MB per file.
MAX_FILE_MB=10
MAX_FILES_PER_REQUEST=5
