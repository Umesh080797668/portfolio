# =====================================================================
# FRONTEND configuration  (frontend/.env)
# Copy this file to ".env" inside the frontend folder:
#     cd frontend && cp .env.example .env
#
# NOTHING HERE IS A SECRET. These values are written into config.js and are visible to
# every visitor of the website. Secrets (Supabase service key, Cloudinary secret, ...)
# belong ONLY in backend/.env.
#
# Build the generated files with:   npm run build
# On Netlify / Cloudflare Pages set the same names as Environment variables
# and use "npm run build" as the build command.
# =====================================================================

# Public address of your backend visitor API, WITHOUT a trailing slash.
# Example: https://portfolio-api.onrender.com
# Local development: http://127.0.0.1:3100
API_BASE_URL=

# Live status updates (optional but recommended). Same project as the backend, PUBLIC values only:
# the anon key can read nothing because every table has Row Level Security with no policies.
# Without these, the tracking page still works but refreshes every 20 seconds instead of instantly.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Upload limits shown to visitors. The backend enforces the real limits
# (keep these equal to MAX_FILE_MB / MAX_FILES_PER_REQUEST in backend/.env).
MAX_FILE_MB=10
MAX_FILES_PER_REQUEST=5

# Digits only, with country code. Used to send quotations on WhatsApp.
WHATSAPP_NUMBER=94704124816

# Formspree form id for the contact form (the part after /f/ in the endpoint URL).
FORMSPREE_FORM_ID=
